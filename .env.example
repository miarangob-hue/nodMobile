EXPO_PUBLIC_API_BASE_URL=https://qhekasefqqoiibjvhfvy.supabase.co/functions/v1
EXPO_PUBLIC_NOD_PROVIDER_API_KEY=replace-with-provider-api-key
EXPO_PUBLIC_NOD_CUSTOMER_API_BASE_URL=https://erssscbpzsosmvpusnru.supabase.co/functions/v1/nod-api
EXPO_PUBLIC_NOD_CUSTOMER_API_KEY=replace-with-customer-api-key
EXPO_PUBLIC_NOD_ADMIN_API_BASE_URL=https://uzirhdcwtylpmpbfjkzv.supabase.co/functions/v1
EXPO_PUBLIC_NOD_ADMIN_API_KEY=replace-with-admin-api-key
EXPO_PUBLIC_MERCADOPAGO_ENABLED=true

# OAuth nativo de Google. Debe ser una credencial de tipo Web Application.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
# Obligatorio para builds iOS; activa también el URL scheme nativo en app.config.js.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id.apps.googleusercontent.com

# Configuración de builds push. No subir los archivos ni valores reales a Git.
EAS_PROJECT_ID=replace-with-eas-project-uuid
GOOGLE_SERVICES_JSON=./secrets/google-services.json
